{
  "name": "cathedral-game",
  "version": "1.0.0",
  "description": "Cathedral - the game of the medieval city. Networked two-player browser implementation built on boardgame.io.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "server": "node src/server/index.js",
    "client": "vite",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview",
    "tournament": "node src/ai/tournament.js",
    "train": "node src/ai/train.js",
    "netbot": "node src/ai/netbot.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "boardgame.io": "^0.50.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0"
  }
}
